# Copy to client/.env and fill in values, OR run 'azd provision' which generates
# this file automatically via hooks/postprovision.sh.

TENANT_ID=<your-entra-tenant-id>
REPRO_CLIENT_ID=<repro-app-registration-client-id>
FIXED_CLIENT_ID=<fixed-app-registration-client-id>
WEB_APP_NAME=<azure-web-app-name>
REPRO_SERVER_URL=https://<web-app-name>.azurewebsites.net
FIXED_SERVER_URL=https://<web-app-name>-staging.azurewebsites.net
REPRO_AUDIENCE=api://cloud-helper-mcp-repro-<env-suffix>
FIXED_AUDIENCE=api://cloud-helper-mcp-fixed-<env-suffix>
