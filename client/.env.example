# Copy to client/.env and fill in values, OR run 'azd provision' if your hooks
# generate this file automatically.

# MCP endpoint under test.
DIRECT_SERVER_URL=https://<web-app-name>.azurewebsites.net/mcp

# Resource/server app registration (used to derive api://.../mcp.access).
AZURE_CLIENT_ID=<server-app-registration-client-id>

# Optional explicit scope override. Default is api://<AZURE_CLIENT_ID>/mcp.access.
DIRECT_SCOPE=api://<server-app-registration-client-id>/mcp.access

# Optional public client override for CLI automation. If omitted, test_client.py
# defaults to VS Code's public client ID: aebc6443-996d-45c2-90f0-388ff96faa56.
TEST_CLIENT_ID=<optional-pre-registered-public-client-id>
